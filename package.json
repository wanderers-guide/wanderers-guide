{
  "name": "wanderers-guide",
  "private": true,
  "scripts": {
    "docker:start": "docker compose up -d",
    "docker:stop": "docker compose down",
    "docker:rebuild": "docker compose up -d --build frontend",
    "docker:reset": "docker compose down -v && docker compose up -d --wait && ./data/create-db-docker.sh && ./data/seed-test-user.sh",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:check": "npm --prefix docs run broken-links",
    "test:api": "cd supabase && deno test --no-check --allow-net --allow-env --allow-read functions/_tests/",
    "test:api:boundaries": "node supabase/tests/api-boundaries.mjs && node supabase/tests/account-handler-boundaries.mjs",
    "test:release": "node --test scripts/release.test.mjs scripts/production-health.test.mjs",
    "release:check": "node scripts/release.mjs check-local",
    "release:manifest": "node scripts/release.mjs manifest",
    "release:verify": "node scripts/release.mjs check-remote",
    "test:authorization": "docker compose exec -T db psql -U postgres -v ON_ERROR_STOP=1 -f - < supabase/tests/account-moderation-writes.sql"
  }
}
