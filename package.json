{
  "name": "wanderers-guide",
  "private": true,
  "scripts": {
    "docker:start": "docker compose up -d",
    "docker:stop": "docker compose down",
    "docker:rebuild": "docker compose up -d --build frontend",
    "docker:reset": "docker compose down -v && docker compose up -d --wait && ./data/create-db-docker.sh && ./data/seed-test-user.sh",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:check": "npm --prefix docs run broken-links",
    "test:api": "cd supabase && deno test --no-check --allow-net --allow-env --allow-read functions/_tests/",
    "test:api:boundaries": "node supabase/tests/api-boundaries.mjs && node supabase/tests/account-handler-boundaries.mjs && node --test supabase/tests/patreon-linking.test.mjs",
    "test:release": "node --test scripts/release.test.mjs scripts/production-health.test.mjs",
    "test:content:contracts": "node --test scripts/historical-content-fixture.test.mjs scripts/treasure-vault-native-contract.test.mjs scripts/treasure-vault-native-ordering-contract.test.mjs scripts/treasure-vault-native-family-contract.test.mjs scripts/treasure-vault-native-registered-ci-replays.test.mjs scripts/treasure-vault-native-file-transport.test.mjs scripts/treasure-vault-native-engine.test.mjs scripts/treasure-vault-native-engine-dispatch.test.mjs scripts/treasure-vault-native-source-corrections.test.mjs scripts/tech-core-general-spells-native.test.mjs scripts/treasure-vault-native-tech-core-prerequisites.test.mjs scripts/treasure-vault-native-shared-ancestries.test.mjs",
    "test:content:native": "node scripts/treasure-vault-native-safety.mjs",
    "release:check": "node scripts/release.mjs check-local",
    "release:manifest": "node scripts/release.mjs manifest",
    "release:verify:functions": "node scripts/release.mjs check-remote-functions",
    "release:verify": "node scripts/release.mjs check-remote",
    "test:authorization": "docker compose exec -T db psql -U postgres -v ON_ERROR_STOP=1 -f - < supabase/tests/account-moderation-writes.sql"
  }
}
